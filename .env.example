# Server-side only. Never prefix secrets with VITE_ — Vite would inline them into the browser bundle.
# Locally these go in .env. Google AI Studio injects GEMINI_API_KEY itself (Settings → Secrets);
# on Cloud Run or Vercel set them as environment variables.

# --- Model providers (set at least one; each one's models appear only when its key is set) ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# OpenRouter: https://openrouter.ai/keys (a free-tier key allows 50 requests/day on :free models)
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
# Optional extra OpenRouter keys. Any key is a fallback when another is rejected, out of credit or at its own limit.
# Keys on the same OpenRouter account share its free daily limit, so they don't add quota.
# OPENROUTER_API_KEY_BACKUP=
# OPENROUTER_API_KEY_BACKUP_2=
# Default model for new visitors (a model id from GET /api/models). Unset or unknown → gemini-3.6-flash.
DEFAULT_MODEL=gemini-3.6-flash

# --- Fallback (docs/ROUTING.md; only when a user turns on "Fall back if my chosen model fails") ---
# Models tried per request, and how long one model may take to start before the next is tried.
# ROUTER_MAX_ATTEMPTS=3
# ROUTER_ATTEMPT_TIMEOUT_SECONDS=45
# Live provider catalogs (refreshed hourly); "false" uses server/catalog-snapshot.mjs only.
# MODEL_REGISTRY_LIVE=true
# Gemini: "paid" includes Pro models and real prices; GEMINI_MIN_VERSION overrides "newest generation only".
# GEMINI_TIER=free
# GEMINI_MIN_VERSION=3
# OpenRouter: comma-separated ids to exclude from discovery, and non-free ids to add.
# OPENROUTER_EXCLUDE=thinkingmachines/inkling:free,thinkingmachines/inkling-small:free
# Non-free models are not added by default (they cost money). Example: OPENROUTER_EXTRA_MODELS=vendor/model-id
# OPENROUTER_EXTRA_MODELS=

# --- Server ---
# Port for `npm run dev` / `npm start` (AI Studio and Cloud Run expect 3000 / set PORT themselves).
PORT=3000

# --- Rate limits (the demo's abuse protection; there is no sign-in) ---
# With a database URL, limits are global across all instances; without one they are per process.
# DATABASE_URL=postgres://...
RATE_LIMIT_CHAT_PER_MIN=6
RATE_LIMIT_CHAT_PER_DAY=120
RATE_LIMIT_GLOBAL_PER_DAY=1500
MAX_CONCURRENT_STREAMS=2

# --- Output and timing ---
# App cap on output tokens; each model is further limited to what its provider accepts (server/registry.mjs).
MAX_OUTPUT_TOKENS=300000
# How long a provider may take to start streaming (capped below the stream limit).
UPSTREAM_QUEUE_TIMEOUT_SECONDS=120
# Optional override for the per-response stream limit. Default: 10 min locally; on Cloud Run and
# Vercel, FUNCTION_MAX_DURATION (300 = the platform request timeout) minus 15 s.
# STREAM_LIMIT_SECONDS=600

# --- Logging ---
# One line per /api request: method, path, status, duration, hashed client id. No bodies or IPs.
LOG_REQUESTS=true
# Salt for the hashed client id in logs (random per process if unset).
# LOG_SALT=
